# ============================================
# 环境变量配置
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已被 .gitignore 排除，不会提交到仓库
# ============================================

# ---------- 运行模式 ----------
# 是否使用 Mock 模式
# true  = 使用本地预设剧情（零成本，适合开发测试）
# false = 调用真实 AI API（需要下方 AI 配置有效）
VITE_USE_MOCK=true

# ---------- AI 服务配置 ----------
# API 基础地址（不需要末尾的 /chat/completions）
VITE_AI_API_BASE=

# API Key（从对应平台控制台获取）
VITE_AI_API_KEY=

# 模型名称
VITE_AI_MODEL=doubao-pro

# ---------- Supabase 数据库配置 ----------
# （可选，不配也能跑，只是没有排行榜和数据统计）
# 在 Supabase 项目设置 → API 中获取
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
